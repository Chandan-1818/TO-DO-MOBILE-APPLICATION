<?xml version="1.0" encoding="utf-8"?>
<!-- Master is local-only: nothing is included in Android Auto Backup (API < 31).
     Use Master's own Backup & Restore (Profile > Backup & restore) instead. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
