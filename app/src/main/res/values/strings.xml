    <!-- About and categories -->
    <string name="about_title">About Master</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_description">Master is a personal productivity app for planning your days, building habits and protecting your focus. It is made for one person and works entirely on this device.</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_body">Everything you enter stays on this phone. Master has no account on any server, no internet permission, no analytics and no ads. The only permission it asks for is showing reminders. Your PIN is never stored: only a salted, slow hash that is further encrypted with a key held by Android. Backups you export are plain files containing your data but never your PIN or keys. Forgotten PINs cannot be recovered.</string>
    <string name="about_ack_title">Acknowledgements</string>
    <string name="about_ack_body">Built with Kotlin, Jetpack Compose, Material 3, Room, DataStore, WorkManager, Hilt and AndroidX Biometric (open source, Apache License 2.0). The samurai artwork is the app\'s visual identity, supplied by the developer.</string>
